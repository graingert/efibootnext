# 50_efibootnext - detect non-self EFI boot entries via efibootmgr
# and emit GRUB menu entries that use `bootnext --reboot` to hand off
# to those entries for one boot only.
#
# This avoids chainloading entirely: instead of loading another EFI
# binary through GRUB (which is fragile under Secure Boot / NX / shim),
# we write the UEFI BootNext variable and reboot, letting the firmware
# load the target directly.
#
# Configuration via /etc/default/grub:
#
#   GRUB_BOOTNEXT_DISABLE=true
#       Disable this script entirely.
#
#   GRUB_BOOTNEXT_EXCLUDE="regexp"
#       Extended regexp of Boot#### labels to skip.
#       Default: entries whose label matches BootCurrent's label.
#
#   GRUB_BOOTNEXT_INCLUDE="regexp"
#       If set, only emit entries whose label matches this regexp.
#       Overrides the default exclude logic.
set -e

prefix="/usr"
exec_prefix="/usr"
datarootdir="/usr/share"

. "$pkgdatadir/grub-mkconfig_lib"

export TEXTDOMAIN=grub
export TEXTDOMAINDIR="${datarootdir}/locale"

# ── bail early ──────────────────────────────────────────────────────

if [ "${GRUB_BOOTNEXT_DISABLE}" = "true" ]; then
    exit 0
fi

if ! command -v efibootmgr > /dev/null 2>&1; then
    grub_warn "efibootmgr not found; 50_efibootnext will not generate entries."
    exit 0
fi

if [ ! -d /sys/firmware/efi ]; then
    # not booted in EFI mode
    exit 0
fi

# ── read efibootmgr ────────────────────────────────────────────────

EFI_OUTPUT="$(efibootmgr 2>/dev/null)" || {
    grub_warn "efibootmgr failed; 50_efibootnext will not generate entries."
    exit 0
}

# Determine BootCurrent so we can skip our own entry by default.
BOOT_CURRENT="$(printf '%s\n' "${EFI_OUTPUT}" | \
    sed -n 's/^BootCurrent: *\([0-9A-Fa-f]\{4\}\)/\1/p')"

# Find the label of our own entry so we can exclude it.
CURRENT_LABEL=""
if [ -n "${BOOT_CURRENT}" ]; then
    CURRENT_LABEL="$(printf '%s\n' "${EFI_OUTPUT}" | \
        sed -n "s/^Boot${BOOT_CURRENT}\*\{0,1\} *//p")"
fi

# ── parse Boot#### lines ───────────────────────────────────────────
#
# efibootmgr output looks like:
#   Boot0000* Windows Boot Manager
#   Boot0001* ubuntu
#   Boot0002  Some Inactive Entry
#
# We want: active entries (with *), skipping our own.

printf '%s\n' "${EFI_OUTPUT}" | \
    sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\* *\(.*\)/\1 \2/p' | \
while IFS=' ' read -r bootnum label; do

    # skip empty labels
    [ -z "${label}" ] && continue

    # ── filtering ───────────────────────────────────────────────────

    # skip our own entry by boot number
    if [ -n "${BOOT_CURRENT}" ] && [ "${bootnum}" = "${BOOT_CURRENT}" ]; then
        continue
    fi

    # GRUB_BOOTNEXT_INCLUDE: allowlist mode
    if [ -n "${GRUB_BOOTNEXT_INCLUDE}" ]; then
        if ! printf '%s' "${label}" | grep -qE "${GRUB_BOOTNEXT_INCLUDE}"; then
            continue
        fi
    else
        # default: skip entries that match our own label (catches
        # duplicate "ubuntu" entries from old installs etc.)
        if [ -n "${CURRENT_LABEL}" ] && [ "${label}" = "${CURRENT_LABEL}" ]; then
            continue
        fi

        # GRUB_BOOTNEXT_EXCLUDE: blocklist mode
        if [ -n "${GRUB_BOOTNEXT_EXCLUDE}" ]; then
            if printf '%s' "${label}" | grep -qE "${GRUB_BOOTNEXT_EXCLUDE}"; then
                continue
            fi
        fi
    fi

    # ── emit ────────────────────────────────────────────────────────

    echo "Adding boot menu entry for EFI boot entry: ${label} (Boot${bootnum})" >&2

    # Escape single quotes in the label for safe embedding in grub.cfg
    escaped_label="$(printf '%s' "${label}" | sed "s/'/'\\\\''/g")"

    cat << EOF
if [ "\$grub_platform" = "efi" ]; then
  menuentry '${escaped_label} (via BootNext)' \$menuentry_id_option 'efi-bootnext-${bootnum}' {
    insmod efibootnext
    bootnext --reboot ${bootnum}
  }
fi
EOF

done
